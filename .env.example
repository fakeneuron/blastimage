# .env.example — committed template; copy to .env and fill in real values.
# .env is gitignored (.env* rule in configs/.gitignore); .env.example is not.
# Never commit secrets to version control.

# --- App ---
# APP_NAME=myapp
# APP_ENV=development        # development | staging | production
# APP_SECRET_KEY=            # generate with: openssl rand -hex 32

# --- Database ---
# DATABASE_URL=              # e.g. postgresql://user:password@localhost:5432/dbname
                             #      sqlite:///./app.db

# --- External APIs ---
# SOME_API_KEY=
# SOME_API_BASE_URL=

# --- Feature flags ---
# FEATURE_FOO=false
