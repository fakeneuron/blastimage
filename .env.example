# .env.example — committed template; copy to .env and fill in real values.
# .env is gitignored (.env* rule in configs/.gitignore); .env.example is not.
# Never commit secrets to version control.

# --- Mode (BI-022.3) ---
# blastimage runs frontend-only on localStorage by default (local/submodule
# mode). Set to "hosted" to enable the Supabase-backed personal cloud instance.
# Unset (or any other value) keeps the app byte-identical to the local mode.
# NEXT_PUBLIC_BLASTIMAGE_MODE=hosted

# --- Supabase (hosted mode only) ---
# Required when NEXT_PUBLIC_BLASTIMAGE_MODE=hosted. For the local Supabase stack,
# `supabase start` prints the API URL (http://127.0.0.1:54341) and anon key.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
